# Public base URL of the API, as reached from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API base URL as reached from the Next.js server (server components, sitemap).
# In dev this is the same as NEXT_PUBLIC_API_URL; in Docker set it to the
# compose service name, e.g. http://api:8000. Falls back to NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://localhost:8000

# Public, absolute base URL of the site itself. Used for metadataBase,
# canonical/hreflang links, Open Graph URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry error monitoring (optional). Leave NEXT_PUBLIC_SENTRY_DSN empty to
# disable client + server error reporting entirely. The DSN is safe to expose
# to the browser. Set it only in production.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_TRACES_SAMPLE_RATE=0.0
# Source-map upload at build time (optional; only needed for readable stack
# traces in Sentry). Leave unset to skip upload.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
